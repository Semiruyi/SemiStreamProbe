{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "SSP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "SemiStreamProbe MinGW Debug",
      "description": "Debug build with tests using the MinGW toolchain.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "SemiStreamProbe MinGW Release",
      "description": "Release build with tests using the MinGW toolchain.",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-sanitizers",
      "displayName": "SemiStreamProbe Linux ASan/UBSan",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-sanitizers",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SSP_BUILD_TESTS": "ON",
        "SSP_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release"
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "testPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

